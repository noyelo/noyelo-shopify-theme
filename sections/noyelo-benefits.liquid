{%- render 'noyelo-section-padding',
  section_id: section.id,
  top: section.settings.padding_top,
  bottom: section.settings.padding_bottom
-%}

{%- liquid
  assign layout = section.settings.layout
  assign half = section.blocks.size | plus: 1 | divided_by: 2
-%}

<div class="ny-benefits ny-benefits--{{ layout }} color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank or section.settings.text != blank -%}
      <div class="ny-section-intro ny-section-intro--{{ section.settings.intro_alignment }}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {%- if section.settings.eyebrow != blank -%}
          <p class="ny-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="ny-heading h1">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="ny-lead">{{ section.settings.text }}</div>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- capture benefit_items -%}
      {%- for block in section.blocks -%}
        <li
          class="ny-benefit{% if block.settings.image != blank %} ny-benefit--has-image{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          {% if settings.animations_reveal_on_scroll %}
            data-cascade style="--animation-order: {{ forloop.index }};"
          {% endif %}
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.image != blank and layout == 'cards' -%}
            <div class="ny-benefit__image ny-media">
              {%- render 'noyelo-image', image: block.settings.image, sizes: '(min-width: 990px) 25vw, (min-width: 750px) 50vw, 90vw' -%}
            </div>
          {%- else -%}
            <span class="ny-benefit__icon">{%- render 'noyelo-icon', icon: block.settings.icon -%}</span>
          {%- endif -%}
          <h3 class="ny-benefit__title h3">{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}
            <div class="ny-benefit__text">{{ block.settings.text }}</div>
          {%- endif -%}
        </li>
      {%- endfor -%}
    {%- endcapture -%}

    {%- if layout == 'split' -%}
      <div class="ny-benefits__split">
        <ul class="ny-benefits__col ny-benefits__col--left" role="list">
          {%- for block in section.blocks limit: half -%}
            <li class="ny-benefit ny-benefit--inline" {{ block.shopify_attributes }}>
              <span class="ny-benefit__icon">{%- render 'noyelo-icon', icon: block.settings.icon -%}</span>
              <div>
                <h3 class="ny-benefit__title h3">{{ block.settings.title }}</h3>
                {%- if block.settings.text != blank -%}
                  <div class="ny-benefit__text">{{ block.settings.text }}</div>
                {%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        </ul>
        <div class="ny-benefits__center ny-media{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          {%- render 'noyelo-image',
            image: section.settings.image,
            sizes: '(min-width: 990px) 34vw, 100vw',
            placeholder: 'product-2',
            art: section.settings.default_art
          -%}
        </div>
        <ul class="ny-benefits__col ny-benefits__col--right" role="list">
          {%- for block in section.blocks offset: half -%}
            <li class="ny-benefit ny-benefit--inline" {{ block.shopify_attributes }}>
              <span class="ny-benefit__icon">{%- render 'noyelo-icon', icon: block.settings.icon -%}</span>
              <div>
                <h3 class="ny-benefit__title h3">{{ block.settings.title }}</h3>
                {%- if block.settings.text != blank -%}
                  <div class="ny-benefit__text">{{ block.settings.text }}</div>
                {%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    {%- else -%}
      <ul class="ny-benefits__grid" role="list" style="--ny-cols: {{ section.settings.columns_desktop }};">
        {{ benefit_items }}
      </ul>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="ny-benefits__cta">
        <a
          {% if section.settings.button_link == blank %}
            role="link" aria-disabled="true"
          {% else %}
            href="{{ section.settings.button_link }}"
          {% endif %}
          class="button button--primary"
        >
          {{- section.settings.button_label | escape -}}
          {%- render 'noyelo-icon', icon: 'arrow-right' -%}
        </a>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "NOYELO Produktvorteile",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "max_blocks": 8,
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "split",
          "label": "Bild in der Mitte, Vorteile links & rechts"
        },
        {
          "value": "cards",
          "label": "Karten-Raster"
        }
      ],
      "default": "split"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Bild in der Mitte",
      "info": "Nur für das Layout mit Bild in der Mitte. Ideal: Produktfreisteller im Hochformat."
    },
    {
      "type": "select",
      "id": "default_art",
      "label": "Standardbild in der Mitte",
      "options": [
        {
          "value": "none",
          "label": "Keins"
        },
        {
          "value": "product-image-1",
          "label": "Produktbild 1 (Hauptprodukt)"
        },
        {
          "value": "product-image-2",
          "label": "Produktbild 2 (Hauptprodukt)"
        },
        {
          "value": "product-image-3",
          "label": "Produktbild 3 (Hauptprodukt)"
        },
        {
          "value": "hero",
          "label": "Kissen auf Wolken (quer)"
        },
        {
          "value": "hero-mobile",
          "label": "Kissen auf Wolken (hoch, mobil)"
        },
        {
          "value": "product-main",
          "label": "Produkt – Oberseite"
        },
        {
          "value": "product-ice",
          "label": "Produkt – hellblaue Seite"
        },
        {
          "value": "product-cloud",
          "label": "Produkt auf Wolken (hoch)"
        },
        {
          "value": "material",
          "label": "Material-Nahaufnahme"
        },
        {
          "value": "layers",
          "label": "Querschnitt / Schichten"
        },
        {
          "value": "pos-side",
          "label": "Seitenlage"
        },
        {
          "value": "pos-back",
          "label": "Rückenlage"
        },
        {
          "value": "pos-stomach",
          "label": "Bauchlage"
        },
        {
          "value": "night",
          "label": "Nachtszene"
        }
      ],
      "default": "product-cloud",
      "info": "Wird angezeigt, solange kein eigenes Bild ausgewählt ist."
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 2,
      "max": 4,
      "step": 1,
      "label": "Spalten (Karten-Raster, Desktop)",
      "default": 4
    },
    {
      "type": "header",
      "content": "Einleitung"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Kleine Überzeile",
      "default": "Warum NOYELO"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Überschrift",
      "default": "Durchdacht bis in die kleinste Schicht."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "select",
      "id": "intro_alignment",
      "label": "Ausrichtung Einleitung",
      "options": [
        {
          "value": "left",
          "label": "Links"
        },
        {
          "value": "center",
          "label": "Zentriert"
        }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button-Text (optional)"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button-Link"
    },
    {
      "type": "header",
      "content": "Design"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Farbschema",
      "default": "scheme-2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Abstand oben",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Abstand unten",
      "default": 96
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Vorteil",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "check",
              "label": "Häkchen"
            },
            {
              "value": "moon",
              "label": "Mond"
            },
            {
              "value": "truck",
              "label": "Versand"
            },
            {
              "value": "return",
              "label": "Rückgabe"
            },
            {
              "value": "shield",
              "label": "Schutz / Garantie"
            },
            {
              "value": "cloud",
              "label": "Wolke / Komfort"
            },
            {
              "value": "pillow",
              "label": "Kissen"
            },
            {
              "value": "layers",
              "label": "Schichten"
            },
            {
              "value": "air",
              "label": "Luft / Atmungsaktiv"
            },
            {
              "value": "leaf",
              "label": "Blatt / Natur"
            },
            {
              "value": "wash",
              "label": "Waschbar"
            },
            {
              "value": "contour",
              "label": "Ergonomische Kontur"
            },
            {
              "value": "spine",
              "label": "Wirbelsäule"
            },
            {
              "value": "feather",
              "label": "Feder / Druckentlastung"
            },
            {
              "value": "temperature",
              "label": "Temperatur"
            },
            {
              "value": "heart",
              "label": "Herz"
            },
            {
              "value": "star",
              "label": "Stern"
            },
            {
              "value": "sparkle",
              "label": "Funkeln"
            },
            {
              "value": "calendar",
              "label": "Kalender"
            },
            {
              "value": "lock",
              "label": "Schloss / Sicher"
            },
            {
              "value": "package",
              "label": "Paket"
            },
            {
              "value": "chat",
              "label": "Chat / Service"
            },
            {
              "value": "pin",
              "label": "Standort"
            },
            {
              "value": "none",
              "label": "Kein Icon"
            }
          ],
          "default": "contour"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Bild (nur Karten-Raster, optional)"
        },
        {
