        }
      ]
    }
  ],
  "presets": [
    {
      "name": "NOYELO Produktvorteile",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "contour",
            "title": "Ergonomische Unterstützung",
