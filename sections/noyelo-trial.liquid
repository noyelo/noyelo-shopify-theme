  "class": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "number",
      "label": "Große Zahl",
      "default": "30"
    },
    {
      "type": "text",
      "id": "unit",
      "label": "Einheit",
      "default": "Nächte"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Kleine Überzeile",
      "default": "Ohne Risiko"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Überschrift",
      "default": "30 Nächte zuhause testen."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Dein Körper braucht ein paar Nächte, um sich an ein neues Kissen zu gewöhnen. Deshalb nimmst du dir bei uns die Zeit – in deinem eigenen Bett.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Bild (optional)"
    },
    {
      "type": "select",
      "id": "default_art",
      "label": "Standardbild",
      "options": [
        {
          "value": "none",
