{%- render 'noyelo-section-padding',
  section_id: section.id,
  top: section.settings.padding_top,
  bottom: section.settings.padding_bottom
-%}

<div class="ny-trial color-{{ section.settings.outer_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="ny-trial__card color-{{ section.settings.color_scheme }}{% if section.settings.image != blank or section.settings.default_art != 'none' %} ny-trial__card--image{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      <div class="ny-trial__content">
        <div class="ny-trial__badge" aria-hidden="true">
          <span class="ny-trial__number">{{ section.settings.number | escape }}</span>
          <span class="ny-trial__unit">{{ section.settings.unit | escape }}</span>
          {%- render 'noyelo-icon', icon: 'moon', class: 'ny-trial__moon' -%}
        </div>
        {%- if section.settings.eyebrow != blank -%}
          <p class="ny-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="ny-heading h1">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="ny-lead">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.blocks.size > 0 -%}
          <ol class="ny-trial__steps" role="list">
            {%- for block in section.blocks -%}
              <li class="ny-trial__step" {{ block.shopify_attributes }}>
                <span class="ny-trial__step-icon">{%- render 'noyelo-icon', icon: block.settings.icon -%}</span>
                <span class="ny-trial__step-copy">
                  <span class="ny-trial__step-title">{{ block.settings.title }}</span>
                  {%- if block.settings.text != blank -%}
                    <span class="ny-trial__step-text">{{ block.settings.text }}</span>
                  {%- endif -%}
                </span>
              </li>
            {%- endfor -%}
          </ol>
        {%- endif -%}

        {%- if section.settings.button_label != blank or section.settings.link_label != blank -%}
          <div class="ny-btn-row">
            {%- if section.settings.button_label != blank -%}
              <a
                {% if section.settings.button_link == blank %}
                  role="link" aria-disabled="true"
                {% else %}
                  href="{{ section.settings.button_link }}"
                {% endif %}
                class="button button--primary"
              >
                {{- section.settings.button_label | escape -}}
              </a>
            {%- endif -%}
            {%- if section.settings.link_label != blank and section.settings.link_url != blank -%}
              <a href="{{ section.settings.link_url }}" class="ny-link-arrow">
                {{- section.settings.link_label | escape -}}
                {%- render 'noyelo-icon', icon: 'arrow-right' -%}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- if section.settings.image != blank or section.settings.default_art != 'none' -%}
        <div class="ny-trial__media ny-media">
          {%- render 'noyelo-image',
            image: section.settings.image,
            sizes: '(min-width: 990px) 55vw, 100vw',
            art: section.settings.default_art
          -%}
          {%- if section.settings.image == blank and section.settings.default_art == 'night' -%}
            {%- comment -%} Occasional soft star twinkles in the night sky (decorative) {%- endcomment -%}
            <div class="ny-twinkle" aria-hidden="true">
              <span style="--x: 9%; --y: 9%; --d: 0.4s; --t: 7s; --s: 1;"></span>
              <span style="--x: 27%; --y: 22%; --d: 2.6s; --t: 8.5s; --s: 0.8;"></span>
              <span style="--x: 41%; --y: 7%; --d: 5.1s; --t: 9s; --s: 1.1;"></span>
              <span style="--x: 16%; --y: 36%; --d: 3.8s; --t: 7.5s; --s: 0.75;"></span>
              <span style="--x: 55%; --y: 27%; --d: 1.5s; --t: 10s; --s: 0.9;"></span>
              <span style="--x: 64%; --y: 12%; --d: 6.4s; --t: 8s; --s: 0.8;"></span>
              <span style="--x: 34%; --y: 36%; --d: 4.6s; --t: 9.5s; --s: 0.7;"></span>
              <span style="--x: 82%; --y: 40%; --d: 7.2s; --t: 8.8s; --s: 0.85;"></span>
              <span style="--x: 5%; --y: 41%; --d: 2.1s; --t: 10.5s; --s: 0.7;"></span>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
