{%- render 'noyelo-section-padding',
  section_id: section.id,
  top: section.settings.padding_top,
  bottom: section.settings.padding_bottom
-%}

<div class="ny-split color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="ny-split__grid ny-split__grid--image-{{ section.settings.image_position }} ny-split__grid--{{ section.settings.vertical_alignment }}">
      <div class="ny-split__media{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        <div class="ny-split__image ny-media ny-media--{{ section.settings.image_ratio }}">
          {%- render 'noyelo-image',
            image: section.settings.image,
            sizes: '(min-width: 990px) 50vw, 100vw',
            placeholder: 'lifestyle-1',
            art: section.settings.default_art
          -%}
        </div>
        {%- if section.settings.image_caption != blank -%}
          <p class="ny-split__caption">{{ section.settings.image_caption }}</p>
        {%- endif -%}
      </div>

      <div class="ny-split__content{% if section.settings.content_card %} ny-split__content--card{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {%- if section.settings.eyebrow != blank -%}
          <p class="ny-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="ny-heading h1">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="ny-split__text ny-lead">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- liquid
          assign points = section.blocks | where: 'type', 'point'
          assign stats = section.blocks | where: 'type', 'stat'
        -%}
        {%- if points.size > 0 -%}
          <ul class="ny-checklist ny-split__list" role="list">
            {%- for block in points -%}
              <li {{ block.shopify_attributes }}>
                {%- render 'noyelo-icon', icon: block.settings.icon -%}
                <span>{{ block.settings.text }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- if stats.size > 0 -%}
          <dl class="ny-stats">
            {%- for block in stats -%}
              <div class="ny-stat" {{ block.shopify_attributes }}>
                <dt class="ny-stat__label">{{ block.settings.label }}</dt>
                <dd class="ny-stat__value">{{ block.settings.value | escape }}</dd>
              </div>
            {%- endfor -%}
          </dl>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <div class="ny-btn-row">
            <a
              {% if section.settings.button_link == blank %}
                role="link" aria-disabled="true"
              {% else %}
                href="{{ section.settings.button_link }}"
              {% endif %}
              class="button {% if section.settings.button_style == 'secondary' %}button--secondary{% else %}button--primary{% endif %}"
            >
              {{- section.settings.button_label | escape -}}
            </a>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
