    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Überschrift",
      "default": "Weich an der Oberfläche. Stabil im Kern."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Beschreibe hier ein Detail deines Produkts – zum Beispiel das Material, die Verarbeitung oder das Schlafgefühl.</p>"
    },
    {
