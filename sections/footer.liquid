{{ 'component-list-social.css' | asset_url | stylesheet_tag }}
{{ 'component-list-payment.css' | asset_url | stylesheet_tag }}
{{ 'noyelo-footer.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      margin-top: {{ section.settings.margin_top }}px;
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign has_social_icons = true
  if settings.social_facebook_link == blank and settings.social_instagram_link == blank and settings.social_youtube_link == blank and settings.social_tiktok_link == blank and settings.social_twitter_link == blank and settings.social_pinterest_link == blank and settings.social_snapchat_link == blank and settings.social_tumblr_link == blank and settings.social_vimeo_link == blank
    assign has_social_icons = false
  endif

  assign footer_logo = section.settings.footer_logo | default: settings.logo
-%}

<footer
  class="ny-footer footer color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding"
  style="--ny-footer-columns: {{ section.blocks.size | at_least: 1 }};"
>
  <div class="page-width">
    {%- if section.settings.newsletter_enable -%}
      <div class="ny-footer__newsletter">
        <div class="ny-footer__newsletter-text">
          {%- if section.settings.newsletter_heading != blank -%}
            <h2 class="ny-footer__newsletter-heading h3">{{ section.settings.newsletter_heading | escape }}</h2>
          {%- endif -%}
          {%- if section.settings.newsletter_text != blank -%}
            <div class="ny-footer__newsletter-copy">{{ section.settings.newsletter_text }}</div>
          {%- endif -%}
        </div>
        {%- form 'customer', id: 'ContactFooter', class: 'ny-newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="ny-newsletter-form__row">
            <label class="visually-hidden" for="NewsletterForm--{{ section.id }}">{{ 'newsletter.label' | t }}</label>
            <input
              id="NewsletterForm--{{ section.id }}"
              type="email"
              name="contact[email]"
              class="ny-newsletter-form__input"
              value="{{ form.email }}"
              aria-required="true"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              {% if form.errors %}
                autofocus
                aria-invalid="true"
                aria-describedby="ContactFooter-error"
              {% elsif form.posted_successfully? %}
                aria-describedby="ContactFooter-success"
              {% endif %}
              placeholder="{{ 'newsletter.label' | t }}"
              required
            >
            <button type="submit" class="button ny-newsletter-form__button" name="commit">
              {{ 'newsletter.button_label' | t }}
            </button>
          </div>
          {%- if form.errors -%}
            <p class="ny-form-message ny-form-message--error" id="ContactFooter-error" role="alert">
              {{- form.errors.translated_fields.email | capitalize }}
              {{ form.errors.messages.email -}}
            </p>
          {%- endif -%}
          {%- if form.posted_successfully? -%}
            <p class="ny-form-message ny-form-message--success" id="ContactFooter-success" tabindex="-1" autofocus>
              {% render 'noyelo-icon', icon: 'check' %}
              {{- 'newsletter.success' | t -}}
            </p>
          {%- endif -%}
        {%- endform -%}
      </div>
    {%- endif -%}

    <div class="ny-footer__grid{% if section.settings.show_brand %} ny-footer__grid--brand{% endif %}">
      {%- if section.settings.show_brand -%}
        <div class="ny-footer__brand">
          <a href="{{ routes.root_url }}" class="ny-footer__logo">
            {%- if footer_logo != blank -%}
              {%- liquid
                assign footer_logo_width = section.settings.logo_width
                assign footer_logo_height = footer_logo_width | divided_by: footer_logo.aspect_ratio | round
                assign footer_logo_style = 'width: min(100%, ' | append: footer_logo_width | append: 'px); height: auto;'
                assign footer_logo_sizes = footer_logo_width | append: 'px'
              -%}
              {{
                footer_logo
                | image_url: width: 480
                | image_tag:
                  widths: '160, 240, 320, 480',
                  sizes: footer_logo_sizes,
                  width: footer_logo_width,
                  height: footer_logo_height,
                  loading: 'lazy',
                  alt: shop.name,
                  style: footer_logo_style
              }}
            {%- else -%}
              <span class="ny-footer__wordmark">{{ shop.name | downcase | escape }}</span>
            {%- endif -%}
          </a>
          {%- if section.settings.brand_text != blank -%}
            <div class="ny-footer__brand-text">{{ section.settings.brand_text }}</div>
          {%- endif -%}
          {%- if section.settings.show_social and has_social_icons -%}
            {%- render 'social-icons', class: 'ny-footer__social' -%}
          {%- endif -%}
          {%- if shop.features.follow_on_shop? and section.settings.enable_follow_on_shop -%}
            <div class="ny-footer__follow">
              {{ shop | login_button: action: 'follow' }}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when '@app' -%}
            <div class="ny-footer__app">{% render block %}</div>
          {%- when 'text' -%}
            <div class="ny-footer__col ny-footer__col--text" {{ block.shopify_attributes }}>
              {%- if block.settings.heading != blank -%}
                <h2 class="ny-footer__heading ny-footer__heading--static">{{ block.settings.heading | escape }}</h2>
              {%- endif -%}
              <div class="ny-footer__text rte">{{ block.settings.subtext }}</div>
            </div>
          {%- else -%}
            {%- liquid
              assign link_count = 0
              if block.type == 'link_list'
                assign link_count = block.settings.menu.links.size
              elsif block.type == 'policies'
                for policy in shop.policies
                  if policy != blank
                    assign link_count = link_count | plus: 1
                  endif
                endfor
              endif
              for i in (1..4)
                assign label_key = 'link_' | append: i | append: '_label'
                assign url_key = 'link_' | append: i | append: '_url'
                if block.settings[label_key] != blank and block.settings[url_key] != blank
                  assign link_count = link_count | plus: 1
                endif
              endfor
            -%}
            {%- if link_count > 0 or request.design_mode -%}
              <details class="ny-footer__col ny-footer__group" data-ny-footer-group open {{ block.shopify_attributes }}>
                <summary class="ny-footer__heading">
                  <span>{{ block.settings.heading | escape }}</span>
                  <span class="ny-footer__toggle" aria-hidden="true">{% render 'noyelo-icon', icon: 'plus' %}</span>
                </summary>
                <ul class="ny-footer__links list-unstyled" role="list">
                  {%- if block.type == 'link_list' -%}
                    {%- for link in block.settings.menu.links -%}
                      <li>
                        <a
                          href="{{ link.url }}"
                          class="ny-footer__link"
                          {% if link.current %}
                            aria-current="page"
                          {% endif %}
                        >
                          {{- link.title | escape -}}
                        </a>
                      </li>
                    {%- endfor -%}
                  {%- elsif block.type == 'policies' -%}
                    {%- for policy in shop.policies -%}
                      {%- if policy != blank -%}
                        <li>
                          <a href="{{ policy.url }}" class="ny-footer__link">{{ policy.title | escape }}</a>
                        </li>
                      {%- endif -%}
                    {%- endfor -%}
                  {%- endif -%}
                  {%- for i in (1..4) -%}
                    {%- liquid
                      assign label_key = 'link_' | append: i | append: '_label'
                      assign url_key = 'link_' | append: i | append: '_url'
                    -%}
                    {%- if block.settings[label_key] != blank and block.settings[url_key] != blank -%}
                      <li>
                        <a href="{{ block.settings[url_key] }}" class="ny-footer__link">
                          {{- block.settings[label_key] | escape -}}
                        </a>
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              </details>
            {%- endif -%}
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="ny-footer__bottom">
      <p class="ny-footer__copyright">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url -}}
        {%- if section.settings.show_powered_by %} · {{ powered_by_link }}{% endif -%}
      </p>

      {%- if section.settings.enable_country_selector and localization.available_countries.size > 1
        or section.settings.enable_language_selector and localization.available_languages.size > 1
      -%}
        <div class="ny-footer__localization footer__localization isolate">
          {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
            <localization-form>
              {%- form 'localization', id: 'FooterCountryForm', class: 'localization-form' -%}
                <div>
                  <h2 class="visually-hidden" id="FooterCountryLabel">{{ 'localization.country_label' | t }}</h2>
                  {%- render 'country-localization', localPosition: 'FooterCountry' -%}
                </div>
              {%- endform -%}
            </localization-form>
          {%- endif -%}
          {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
            <localization-form>
              {%- form 'localization', id: 'FooterLanguageForm', class: 'localization-form' -%}
                <div>
                  <h2 class="visually-hidden" id="FooterLanguageLabel">
                    {{ 'localization.language_label' | t }}
                  </h2>
                  {%- render 'language-localization', localPosition: 'FooterLanguage' -%}
                </div>
              {%- endform -%}
            </localization-form>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.settings.payment_enable and shop.enabled_payment_types.size > 0 -%}
        <div class="ny-footer__payment">
          <span class="visually-hidden">{{ 'sections.footer.payment' | t }}</span>
          <ul class="list list-payment" role="list">
            {%- for type in shop.enabled_payment_types -%}
              <li class="list-payment__item">
                {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "max_blocks": 8,
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "link_list",
      "name": "Linkliste",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Shop",
          "label": "Überschrift"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menü",
          "info": "Menüs werden unter Onlineshop › Navigation angelegt. Es werden nur Links der ersten Ebene angezeigt."
        },
        {
          "type": "header",
          "content": "Zusätzliche Links"
        },
        {
          "type": "text",
          "id": "link_1_label",
          "label": "Link 1 – Text"
        },
        {
          "type": "url",
          "id": "link_1_url",
          "label": "Link 1 – Ziel"
        },
        {
          "type": "text",
          "id": "link_2_label",
          "label": "Link 2 – Text"
        },
        {
          "type": "url",
          "id": "link_2_url",
          "label": "Link 2 – Ziel"
        },
        {
          "type": "text",
          "id": "link_3_label",
          "label": "Link 3 – Text"
        },
        {
          "type": "url",
          "id": "link_3_url",
          "label": "Link 3 – Ziel"
        },
        {
          "type": "text",
          "id": "link_4_label",
          "label": "Link 4 – Text"
        },
        {
          "type": "url",
          "id": "link_4_url",
          "label": "Link 4 – Ziel"
        }
      ]
    },
    {
      "type": "policies",
      "name": "Rechtliches (automatisch)",
      "limit": 1,
      "settings": [
        {
          "type": "paragraph",
          "content": "Listet automatisch alle unter Einstellungen › Richtlinien hinterlegten Seiten (z. B. Impressum, Datenschutz, AGB, Widerruf, Versand)."
        },
        {
          "type": "text",
          "id": "heading",
          "default": "Rechtliches",
          "label": "Überschrift"
        },
        {
          "type": "text",
          "id": "link_1_label",
          "label": "Zusätzlicher Link 1 – Text"
        },
        {
          "type": "url",
          "id": "link_1_url",
          "label": "Zusätzlicher Link 1 – Ziel"
        },
        {
          "type": "text",
          "id": "link_2_label",
          "label": "Zusätzlicher Link 2 – Text"
        },
        {
          "type": "url",
          "id": "link_2_url",
          "label": "Zusätzlicher Link 2 – Ziel"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "default": "Kontakt",
          "label": "Überschrift"
        },
        {
          "type": "richtext",
          "id": "subtext",
          "default": "<p>Wir sind Montag bis Freitag für dich da.</p>",
          "label": "Text"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Farbschema",
      "default": "scheme-2"
    },
    {
      "type": "header",
      "content": "Marke"
    },
    {
      "type": "checkbox",
      "id": "show_brand",
      "default": true,
      "label": "Markenspalte anzeigen"
    },
    {
      "type": "image_picker",
      "id": "footer_logo",
      "label": "Footer-Logo",
      "info": "Optional. Ohne Auswahl wird das Logo aus den Theme-Einstellungen verwendet."
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 60,
      "max": 240,
      "step": 4,
      "unit": "px",
      "label": "Logobreite",
      "default": 120
    },
    {
      "type": "richtext",
      "id": "brand_text",
      "default": "<p>Schlafprodukte, die sich dir anpassen. Entwickelt für erholsame Nächte und entspannte Morgen.</p>",
      "label": "Markentext"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "default": true,
      "label": "Social-Media-Icons anzeigen",
      "info": "Links werden in den Theme-Einstellungen unter Social Media gepflegt."
    },
    {
      "type": "checkbox",
      "id": "enable_follow_on_shop",
      "default": false,
      "label": "„Follow on Shop“ anzeigen"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "newsletter_enable",
      "default": false,
      "label": "Newsletter-Anmeldung im Footer anzeigen"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "default": "Ruhige Post von NOYELO",
      "label": "Überschrift"
    },
    {
      "type": "richtext",
      "id": "newsletter_text",
      "default": "<p>Schlaftipps, Neuheiten und exklusive Angebote – ohne Spam.</p>",
      "label": "Text"
    },
    {
      "type": "header",
      "content": "Länder- und Sprachauswahl"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "default": true,
      "label": "Länder-/Regionsauswahl anzeigen"
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "default": true,
      "label": "Sprachauswahl anzeigen"
    },
    {
      "type": "header",
      "content": "Unterer Bereich"
    },
    {
      "type": "checkbox",
      "id": "payment_enable",
      "default": true,
      "label": "Zahlungsarten anzeigen"
    },
    {
      "type": "checkbox",
      "id": "show_powered_by",
      "default": false,
      "label": "„Powered by Shopify“ anzeigen"
    },
    {
      "type": "header",
      "content": "Abstände"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Abstand oben (außen)",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Innenabstand oben",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Innenabstand unten",
      "default": 32
    }
  ]
}
{% endschema %}
