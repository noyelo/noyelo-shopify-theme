{%- render 'noyelo-section-padding',
  section_id: section.id,
  top: section.settings.padding_top,
  bottom: section.settings.padding_bottom
-%}

<div class="ny-logos color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="ny-logos__heading">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    <ul class="ny-logos__list" role="list">
      {%- for block in section.blocks -%}
        <li class="ny-logos__item" {{ block.shopify_attributes }}>
          {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}" class="ny-logos__link">{%- endif -%}
          {%- if block.settings.logo != blank -%}
            {{
              block.settings.logo
              | image_url: width: 320
              | image_tag:
                widths: '160, 240, 320',
                sizes: '160px',
                loading: 'lazy',
                alt: block.settings.name,
                class: 'ny-logos__img'
            }}
          {%- else -%}
            <span class="ny-logos__name">{{ block.settings.name | escape }}</span>
          {%- endif -%}
          {%- if block.settings.link != blank -%}</a>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "NOYELO Logo-Leiste",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "max_blocks": 8,
  "settings": [
    {
      "type": "paragraph",
      "content": "Für Presse-, Test- oder Partnerlogos. Bitte nur echte Erwähnungen und Auszeichnungen verwenden und die Nutzungsrechte der Logos klären."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Überschrift",
      "default": "Bekannt aus"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Farbschema",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Abstand oben",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Abstand unten",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Logo",
          "info": "Transparentes PNG oder SVG, idealerweise einfarbig."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name (Alt-Text bzw. Text ohne Logo)",
          "default": "Magazin"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "NOYELO Logo-Leiste"
    }
  ]
}
{% endschema %}
