    "faq": {
      "type": "noyelo-faq",
      "settings": {
        "eyebrow": "FAQ",
        "heading": "Fragen zum Kissen",
        "text": "<p>Die wichtigsten Antworten rund um Schlafgefühl, Pflege und Testphase.</p>",
