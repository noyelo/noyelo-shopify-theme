        "f3": {
          "type": "question",
          "settings": {
            "question": "Kann ich den Bezug waschen?",
            "answer": "<p>Ja. Der Bezug ist abnehmbar und bei 40 °C waschbar. Den Memory-Foam-Kern bitte nicht waschen, sondern nur lüften.</p>"
