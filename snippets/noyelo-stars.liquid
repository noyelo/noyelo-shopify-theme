{% comment %}
  Renders an accessible star rating with fractional fill.

  Accepts:
  - rating: {Number} rating value, e.g. 4.8
  - max: {Number} optional, scale maximum (default 5)
  - class: {String} optional extra class

  Usage:
  {% render 'noyelo-stars', rating: 4.8 %}
{% endcomment %}
{%- liquid
  assign scale_max = max | default: 5 | round
  assign rating_value = rating | default: 0 | times: 1.0
  assign percent = rating_value | divided_by: scale_max | times: 100 | at_most: 100 | at_least: 0
  assign rating_label = rating_value | round: 1 | append: '' | replace: '.', ','
-%}
<span
  class="ny-stars{% if class %} {{ class }}{% endif %}"
  role="img"
  aria-label="{{ 'noyelo.reviews.stars_label' | t: rating: rating_label, max: scale_max }}"
  style="--ny-stars-fill: {{ percent }}%;"
>
  {%- capture star -%}
    <svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M10 1.9l2.4 5.1 5.6.7-4.1 3.9 1 5.5L10 14.4l-4.9 2.7 1-5.5L2 7.7l5.6-.7z"/></svg>
  {%- endcapture -%}
  <span class="ny-stars__base" aria-hidden="true">
    {%- for i in (1..scale_max) -%}{{ star }}{%- endfor -%}
  </span>
  <span class="ny-stars__fill" aria-hidden="true">
    {%- for i in (1..scale_max) -%}{{ star }}{%- endfor -%}
  </span>
</span>
