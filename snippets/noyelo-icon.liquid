{% comment %}
  NOYELO line icon set (24px grid, 1.5 stroke, rounded).

  Accepts:
  - icon: {String} icon name (see `noyelo_icon_options` in section schemas)
  - class: {String} optional extra class

  Usage:
  {% render 'noyelo-icon', icon: 'moon' %}
{% endcomment %}
{%- liquid
  assign icon_name = icon | default: 'check'
-%}
{%- unless icon_name == 'none' -%}
  <svg
    class="ny-icon ny-icon--{{ icon_name }}{% if class %} {{ class }}{% endif %}"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    {%- case icon_name -%}
      {%- when 'moon' -%}
        <path d="M19.5 14.6A7.9 7.9 0 0 1 9.4 4.5a7.9 7.9 0 1 0 10.1 10.1Z"/>
      {%- when 'truck' -%}
        <path d="M2.75 7.25a1.5 1.5 0 0 1 1.5-1.5h8.5a1.5 1.5 0 0 1 1.5 1.5v8.5h-3.6M5.1 15.75H2.75v-3"/><path d="M14.25 9.25h3.4c.47 0 .92.22 1.2.6l2 2.65c.2.26.3.57.3.9v2.35h-1.6M14.25 15.75h1.3"/><circle cx="7.4" cy="16.4" r="1.9"/><circle cx="17.6" cy="16.4" r="1.9"/>
      {%- when 'return' -%}
        <path d="M4.75 12a7.25 7.25 0 1 0 2.12-5.13"/><path d="M4.5 4.25v3.5H8"/>
      {%- when 'shield' -%}
        <path d="M12 3.25 5.25 5.9v5.35c0 4.2 2.8 7.7 6.75 9 3.95-1.3 6.75-4.8 6.75-9V5.9z"/><path d="m9.1 12.1 2.05 2.05 3.85-3.9"/>
      {%- when 'cloud' -%}
        <path d="M7.25 18.5h10a4.25 4.25 0 0 0 .55-8.46 5.75 5.75 0 0 0-10.9-.8 4.65 4.65 0 0 0 .35 9.26Z"/>
      {%- when 'layers' -%}
        <path d="m12 3.75 8.25 4.1L12 11.95 3.75 7.85z"/><path d="m3.75 12 8.25 4.1 8.25-4.1"/><path d="m3.75 16.15 8.25 4.1 8.25-4.1"/>
      {%- when 'air' -%}
        <path d="M3.25 9h11.5a2.75 2.75 0 1 0-2.75-2.75"/><path d="M3.25 13h15a2.75 2.75 0 1 1-2.75 2.75"/><path d="M3.25 17h5.5"/>
      {%- when 'leaf' -%}
        <path d="M5.25 19.25c-.3-8.3 4.6-13.8 14-14.5.6 9.4-4.9 14.3-13.2 14.5"/><path d="M5.25 19.25c2.4-4.1 5.4-6.7 9.2-8.4"/>
      {%- when 'wash' -%}
        <path d="M3.75 7h16.5l-1.7 11.1a2 2 0 0 1-1.98 1.7H7.43a2 2 0 0 1-1.98-1.7z"/><path d="M6.4 11.6c1.3-1 2.6-1 3.9 0s2.6 1 3.9 0 2.6-1 3.9 0"/>
      {%- when 'contour' -%}
        <path d="M3.25 16c2.1-3.6 4.2-5.25 6.4-5.25 2.3 0 3 1.9 5.2 1.9s3.6-1.55 5.9-4.9"/><path d="M3.25 19.75h17.5"/>
      {%- when 'feather' -%}
        <path d="M19.25 4.75c-7 0-12.25 5.05-12.25 11.6v2.9"/><path d="M19.25 4.75c0 6.55-4.55 11.6-12.25 11.6"/><path d="M10.6 12.6h5.1"/>
      {%- when 'check' -%}
        <path d="m5 12.5 4.25 4.25L19 7"/>
      {%- when 'close' -%}
        <path d="M6.5 6.5l11 11M17.5 6.5l-11 11"/>
      {%- when 'heart' -%}
        <path d="M12 19.75s-7.5-4.55-7.5-10.05a4.15 4.15 0 0 1 7.5-2.45 4.15 4.15 0 0 1 7.5 2.45c0 5.5-7.5 10.05-7.5 10.05Z"/>
      {%- when 'calendar' -%}
        <rect x="3.75" y="5.25" width="16.5" height="15" rx="2.5"/><path d="M3.75 10h16.5M8 3.5v3.5M16 3.5v3.5"/>
      {%- when 'lock' -%}
        <rect x="4.75" y="10.25" width="14.5" height="10" rx="2.5"/><path d="M8 10.25V7.5a4 4 0 0 1 8 0v2.75"/>
      {%- when 'package' -%}
        <path d="M3.75 7.5 12 3.5l8.25 4v9L12 20.5l-8.25-4z"/><path d="M3.75 7.5 12 11.5l8.25-4M12 11.5v9"/>
      {%- when 'sparkle' -%}
        <path d="M12 3.5c.6 4.3 2.2 5.9 6.5 6.5-4.3.6-5.9 2.2-6.5 6.5-.6-4.3-2.2-5.9-6.5-6.5 4.3-.6 5.9-2.2 6.5-6.5Z"/><path d="M18.5 16.25v3.5M16.75 18h3.5"/>
      {%- when 'temperature' -%}
        <path d="M10 14.2V5.25a2 2 0 1 1 4 0v8.95a4 4 0 1 1-4 0Z"/><path d="M12 15.25v1.5"/>
      {%- when 'chat' -%}
        <path d="M4 6.5A2.5 2.5 0 0 1 6.5 4h11A2.5 2.5 0 0 1 20 6.5v7a2.5 2.5 0 0 1-2.5 2.5H10.5L6 19.75V16h.5"/>
      {%- when 'pin' -%}
        <path d="M12 20.75s6.5-5.8 6.5-11a6.5 6.5 0 0 0-13 0c0 5.2 6.5 11 6.5 11Z"/><circle cx="12" cy="9.75" r="2.25"/>
      {%- when 'pillow' -%}
        <path d="M5 6.8C5 5.5 6 4.8 7.3 5c3.1.5 6.3.5 9.4 0 1.3-.2 2.3.5 2.3 1.8-.6 3.5-.6 6.9 0 10.4 0 1.3-1 2-2.3 1.8-3.1-.5-6.3-.5-9.4 0-1.3.2-2.3-.5-2.3-1.8.6-3.5.6-6.9 0-10.4Z"/>
      {%- when 'spine' -%}
        <path d="M12 3.5c-1.6 2.2-1.6 4.3 0 6.4s1.6 4.3 0 6.4-1.6 2.9 0 4.2"/><path d="M8.5 6.5h7M8 12.75h8M9 18.5h6"/>
      {%- when 'star' -%}
        <path d="m12 3.75 2.45 5.2 5.55.72-4.07 3.88 1.02 5.52L12 16.4l-4.95 2.67 1.02-5.52L4 9.67l5.55-.72z"/>
      {%- when 'arrow-right' -%}
        <path d="M4.75 12h14.5M13.5 6.25 19.25 12l-5.75 5.75"/>
      {%- when 'plus' -%}
        <path d="M12 5.25v13.5M5.25 12h13.5"/>
      {%- when 'minus' -%}
        <path d="M5.25 12h13.5"/>
      {%- when 'info' -%}
        <circle cx="12" cy="12" r="8.25"/><path d="M12 11v5M12 7.75v.01"/>
      {%- when 'ruler' -%}
        <path d="M3.9 15.6 15.6 3.9a1.5 1.5 0 0 1 2.1 0l2.4 2.4a1.5 1.5 0 0 1 0 2.1L8.4 20.1a1.5 1.5 0 0 1-2.1 0l-2.4-2.4a1.5 1.5 0 0 1 0-2.1Z"/><path d="m7.5 12 1.75 1.75M10.5 9l1.75 1.75M13.5 6l1.75 1.75"/>
      {%- else -%}
        <path d="m5 12.5 4.25 4.25L19 7"/>
    {%- endcase -%}
  </svg>
{%- endunless -%}
