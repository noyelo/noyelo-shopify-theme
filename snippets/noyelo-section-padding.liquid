{% comment %}
  Outputs responsive vertical padding for a NOYELO section.
  Mobile uses ~2/3 of the desktop value.

  Accepts:
  - section_id: {String} section.id
  - top: {Number} desktop padding top in px
  - bottom: {Number} desktop padding bottom in px

  Usage:
  {% render 'noyelo-section-padding', section_id: section.id, top: section.settings.padding_top, bottom: section.settings.padding_bottom %}
{% endcomment %}
{%- style -%}
  .section-{{ section_id }}-padding {
    padding-top: {{ top | times: 0.66 | round: 0 }}px;
    padding-bottom: {{ bottom | times: 0.66 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section_id }}-padding {
      padding-top: {{ top }}px;
      padding-bottom: {{ bottom }}px;
    }
  }
{%- endstyle -%}
